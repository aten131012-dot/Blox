-- ==================== TAB 1: MAIN ====================
local MainTab = Window:CreateTab("Main", 4483362458)
local spawnDelay = 0.1

local function createSpawnToggle(name, eventName, flag)
    local active = false
    MainTab:CreateToggle({
        Name = name,
        CurrentValue = false,
        Flag = flag,
        Callback = function(Value)
            active = Value
            if active then
                task.spawn(function()
                    while active do
                        pcall(function()
                            game:GetService("ReplicatedStorage"):WaitForChild(eventName):FireServer()
                        end)
                        task.wait(spawnDelay)
                    end
                end)
            end
        end,
    })
end

createSpawnToggle("ออโต้เสก Lucky Block", "SpawnLuckyBlock", "AutoLucky")
