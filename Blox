-- 3. เปิด/ปิด เห็นชื่อแบบ ESP (Name ESP)
local nameESP = false

local function applyNameESP(player)
    if player == Players.LocalPlayer then return end

    local function addTag(char)
        if not char then return end
        local head = char:WaitForChild("Head", 5)
        if not head then return end

        -- ลบของเก่าออกก่อนป้องกันการซ้ำซ้อน
        if head:FindFirstChild("NameESP_Tag") then
            head.NameESP_Tag:Destroy()
        end

        -- สร้างป้ายชื่อบนหัว
        local bb = Instance.new("BillboardGui")
        bb.Name = "NameESP_Tag"
        bb.Adornee = head
        bb.Size = UDim2.new(0, 100, 0, 30)
        bb.StudsOffset = Vector3.new(0, 2, 0)
        bb.AlwaysOnTop = true -- มองเห็นทะลุกำแพงได้
        bb.Enabled = nameESP

        local txt = Instance.new("TextLabel")
        txt.Size = UDim2.new(1, 0, 1, 0)
        txt.BackgroundTransparency = 1
        txt.Text = player.Name .. " (@" .. player.DisplayName .. ")"
        txt.TextColor3 = Color3.fromRGB(255, 255, 255)
        txt.TextStrokeTransparency = 0
        txt.TextSize = 14
        txt.Parent = bb

        bb.Parent = head
    end

    if player.Character then addTag(player.Character) end
    player.CharacterAdded:Connect(addTag)
end

-- นำไปใช้กับผู้เล่นทุกคนทั้งในเซิร์ฟและคนที่เข้ามาใหม่
for _, plr in pairs(Players:GetPlayers()) do applyNameESP(plr) end
Players.PlayerAdded:Connect(applyNameESP)

PlayerTab:CreateToggle({
    Name = "เปิด/ปิด เห็นชื่อ (Name ESP)",
    CurrentValue = false,
    Callback = function(Value)
        nameESP = Value
        for _, plr in pairs(Players:GetPlayers()) do
            if plr.Character and plr.Character:FindFirstChild("Head") then
                local tag = plr.Character.Head:FindFirstChild("NameESP_Tag")
                if tag then
                    tag.Enabled = nameESP
                end
            end
        end
    end,
})

