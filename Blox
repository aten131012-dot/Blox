-- 2. ทะลุสิ่งของแบบสมบูรณ์ (Noclip All)
local noclip = false
RunService.Stepped:Connect(function()
    if noclip then
        local character = Players.LocalPlayer.Character
        if character then
            for _, part in pairs(character:GetDescendants()) do
